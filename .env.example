# Copy to .env or export in your shell. Never commit a filled .env.

# Pick ONE provider key (or none, for demo mode):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional overrides:
CHATBOT_PROVIDER=          # openai | anthropic | google | demo (default: auto-detect)
CHATBOT_MODEL=             # e.g. gpt-4o, claude-sonnet-4-5, gemini-2.0-flash

# LangSmith tracing (optional):
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=adaptive-llm-chatbot

# LangExtract (optional, defaults to Gemini):
LANGEXTRACT_API_KEY=
LANGEXTRACT_MODEL=gemini-2.5-flash
